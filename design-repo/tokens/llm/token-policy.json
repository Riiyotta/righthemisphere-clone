{
 "version": "1.0.0",
 "pageSpecTokenFields": {
  "surface": {
   "category": "surface"
  },
  "text": {
   "category": "text"
  },
  "spaceBlock": {
   "category": "spacing"
  },
  "font": {
   "category": "fontFamily"
  }
 },
 "pageSpecReferenceable": [
  "surface.page",
  "surface.panel",
  "surface.media-dark",
  "surface.system",
  "surface.tile-black",
  "surface.tile-navy",
  "surface.tile-violet",
  "surface.tile-teal",
  "surface.tile-orange",
  "surface.tile-amber",
  "surface.tile-forest",
  "surface.tile-olive",
  "surface.tile-cyan",
  "text.primary",
  "text.heading",
  "text.muted",
  "text.accent",
  "text.on-dark",
  "text.field",
  "space.96",
  "space.112",
  "space.160",
  "space.192",
  "space.240",
  "font.family.sans"
 ],
 "fontFamilyAllowed": [
  "font.family.sans"
 ],
 "rawValueRestrictions": {
  "color": {
   "rule": "TOKEN_RAW_COLOR",
   "regex": "(?i)(#[0-9a-f]{3,8}\\b|\\brgba?\\(|\\bhsla?\\(|\\b(red|black|white|blue|green|orange|purple|pink|gray|grey|yellow)\\b)"
  },
  "spacing": {
   "rule": "TOKEN_ARBITRARY_SPACING",
   "regex": "(?i)^(-?[0-9.]+\\s*(px|rem|em|%|vw|vh|dvh)?|clamp\\(.*|calc\\(.*)$"
  },
  "fontFamily": {
   "rule": "TOKEN_FONT_UNSUPPORTED",
   "allowed": [
    "font.family.sans"
   ]
  }
 },
 "surfaceTextPairs": {
  "surface.page": [
   "text.primary",
   "text.heading",
   "text.muted",
   "text.accent"
  ],
  "surface.panel": [
   "text.primary",
   "text.heading",
   "text.muted"
  ],
  "surface.media-dark": [
   "text.on-dark"
  ],
  "surface.system": [
   "text.primary"
  ],
  "surface.tile-black": [
   "text.on-dark"
  ],
  "surface.tile-navy": [
   "text.on-dark"
  ],
  "surface.tile-violet": [
   "text.on-dark"
  ],
  "surface.tile-teal": [
   "text.on-dark"
  ],
  "surface.tile-orange": [
   "text.on-dark"
  ],
  "surface.tile-amber": [
   "text.on-dark"
  ],
  "surface.tile-forest": [
   "text.on-dark"
  ],
  "surface.tile-olive": [
   "text.on-dark"
  ],
  "surface.tile-cyan": [
   "text.on-dark"
  ]
 },
 "themes": {
  "light": [
   "surface.page",
   "surface.panel",
   "surface.media-dark",
   "surface.system",
   "surface.tile-black",
   "surface.tile-navy",
   "surface.tile-violet",
   "surface.tile-teal",
   "surface.tile-orange",
   "surface.tile-amber",
   "surface.tile-forest",
   "surface.tile-olive",
   "surface.tile-cyan"
  ]
 },
 "sectionSurfaces": "Read from each section contract's tokens.surfaces / tokens.text (single source of truth).",
 "enforced": [
  "TOKEN_UNKNOWN",
  "TOKEN_CATEGORY",
  "TOKEN_RAW_COLOR",
  "TOKEN_ARBITRARY_SPACING",
  "TOKEN_FONT_UNSUPPORTED",
  "TOKEN_NOT_REFERENCEABLE",
  "TOKEN_THEME_COMBINATION",
  "TOKEN_SURFACE_NOT_ALLOWED"
 ],
 "convention": [
  "The site is white with black text and one blue accent (#120DF7) used only for interaction states and icons: accent is the text.accent / border.accent role, there is no accent field in a PageSpec.",
  "Type scale, spacing rhythm other than the five section paddings, radius (none), shadows (none) and motion are owned by the section/primitive contracts; a PageSpec cannot override them (no per-instance typography field exists).",
  "The original's PP Mori is not a token a generated page may use: it is font.family.reference (not referenceable) and the reference-only asset role font.display-original; generated pages use font.family.sans (Inter, OFL).",
  "Project tile fills (surface.tile-*) are flat placeholder fills behind images, exactly as CLONE_SPEC.md 0.1 tells the clone to keep them; four /work-only fills exist in the catalog but are not referenceable."
 ],
 "evidence": [
