{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "design-repo/schema/pagespec.schema.json",
 "title": "PageSpec",
 "description": "A page composed from this design-repo. mode=reference reconstructs the reference build faithfully; mode=generated builds a new page for someone else and must contain no source identity or content (schema/semantic_validate.py GENERATED_MODE_* rules). DERIVED by extraction/build_derived.py - do not hand-edit.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "pageSpecVersion",
  "mode",
  "template",
  "route",
  "locale",
  "theme",
  "meta",
  "brand",
  "nodes"
 ],
 "properties": {
  "pageSpecVersion": {
   "const": "1.0.0"
  },
  "mode": {
   "enum": [
    "reference",
    "generated"
   ]
  },
  "template": {
   "enum": [
    "home",
    "about",
    "services",
    "work-index",
    "contact",
    "blog-list",
    "blog-post",
    "case-study",
    "not-found"
   ]
  },
  "route": {
   "type": "string",
   "pattern": "^/"
  },
  "locale": {
   "enum": [
    "en"
   ]
  },
  "theme": {
   "enum": [
    "light"
   ]
  },
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "description"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "brand": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "studioName",
    "domain"
   ],
   "properties": {
    "studioName": {
     "type": "string",
     "minLength": 1
    },
    "domain": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/node"
   }
  }
 },
 "definitions": {
  "link": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "href"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "href": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "media": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "assetRole",
    "ref",
    "alt"
   ],
   "properties": {
    "assetRole": {
     "enum": [
      "article.image",
      "award.mark",
      "brand.logo-mark",
      "brand.partner-badge",
      "case.motion-json",
      "case.video-embed",
      "client.logo",
      "fictional.person",
      "fictional.portrait",
      "font.display-original",
      "form.live-endpoint",
      "generated.article-image",
      "generated.brand-mark",
      "generated.motion-graphic",
      "generated.project-visual",
      "icon.ui",
      "licensed-or-fallback.font",
      "original.copy",
      "person.portrait",
      "placeholder.award-mark",
      "placeholder.brand-mark",
      "placeholder.client-logo",
      "placeholder.metric",
      "placeholder.partner-badge",
      "placeholder.url",
      "placeholder.video",
      "user.project-media",
      "work.project-image"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1
    },
    "alt": {
     "type": "string"
    }
   }
  },
  "tokens": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "surface": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "spaceBlock": {
     "type": "string",
     "minLength": 1
    },
    "font": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pattern",
    "reducedMotionFallback"
   ],
   "properties": {
    "pattern": {
     "enum": [
      "accordion-height",
      "contact-lines-slide",
      "credits-overlay-open",
      "hover-arrow-swap",
      "hover-border-accent",
      "hover-colour-fade",
      "hover-team-image",
      "load-intro-home",
      "load-intro-services",
      "load-intro-words",
      "lottie-loop",
      "nav-panel-slide",
      "none",
      "scroll-fade",
      "scroll-fade-width",
      "scroll-rise-y",
      "scroll-scale-in",
      "scroll-scale-stagger",
      "scroll-slide-arrows",
      "scroll-slide-x",
      "scroll-split-chars",
      "scroll-split-lines",
      "slider-outin",
      "smooth-scroll"
     ]
    },
    "reducedMotionFallback": {
     "enum": [
      "none",
      "instant",
      "static-final-state",
      "disabled"
     ]
    }
   }
  },
